# Buendia field-pilot server — configuration.
# Copy to .env and fill in. .env is git-ignored (may contain secrets). PIN every version.
#
# ⚠️ QUOTE any value containing a SPACE or a shell metacharacter (; & | $ \ ' " * ? #).
#    docker compose parses this file literally, but the deploy scripts `source` it in bash, so
#    an unquoted  NAME=DRC Pilot Site  or a passphrase containing ';' aborts them with
#    "command not found". Single-quote it:  NAME='DRC Pilot Site'
#    Values are also allowed a trailing `# comment` (bash treats it as one after whitespace).

# --- Site / network -------------------------------------------------------
SITE_ID=pilot
STATIC_IP=192.168.8.10            # server's fixed LAN address (also baked into the APK)
TZ=UTC                            # server + MySQL share UTC (fixes bug 1)

# setup.sh GENERATES /etc/netplan/60-buendia.yaml from these — there is no checked-in netplan
# file to drift out of sync with STATIC_IP.
NET_RENDERER=                     # empty = autodetect (NetworkManager on Ubuntu Desktop,
                                  #   systemd-networkd on Ubuntu Server). Getting this wrong means
                                  #   the static IP silently doesn't apply.
CONFIGURE_NETWORK=true            # true = the shipping mode: this box is cabled to OUR router and takes
                                  #   STATIC_IP inside the subnet that router hands out.
                                  #   false = don't touch networking, for a box that already holds
                                  #   STATIC_IP by other means (dev/test). You must then confirm by hand
                                  #   that the server really answers on STATIC_IP — every tablet has
                                  #   that address baked in.
NET_IFACE=                        # empty = autodetect the wired interface (see: ip -br link)
NET_PREFIX=24                     # netmask bits
GATEWAY_IP=192.168.8.1            # OUR router. Leave it set: empty means no default route AND no
                                  #   resolver, and setup.sh then dies at the chrony install (its first
                                  #   apt-get), long before the image pull. Only blank it for a box that
                                  #   is deliberately isolated and needs no packages.
DNS_SERVERS=192.168.8.1           # OUR router's dnsmasq — the same resolver that carries the tablet
                                  #   clock intercept. Comma-separated if more than one.
NET_ROUTE_METRIC=1000             # How hard the WIRED default route competes. It must LOSE, because
                                  #   the internet comes from somewhere else: this laptop joins a Wi-Fi
                                  #   (site, MSF corporate, phone hotspot) or takes a tethered phone,
                                  #   while staying cabled to the Buendia router for the tablets.
                                  #   NetworkManager's automatic metrics are per device type —
                                  #   ethernet 100, Wi-Fi 600 — and a static route under the networkd
                                  #   renderer defaults to 0, so an unweighted wired route wins and
                                  #   sends every packet to a router with no internet behind it.
                                  #   1000 loses to both, and still works when it is the only way out.

# WHICH ADDRESS the stack publishes its ports on. Empty = 0.0.0.0 = every connection, which is
# what local development and a throwaway stack want — and a data-protection problem on the
# shipping server. The moment that laptop joins MSF's corporate Wi-Fi or the site's, a port on
# 0.0.0.0 is offered to everyone on that network: :9000 is patient data behind one well-known
# account, and :9001 serves the APK, which carries the clinical password as a plain Android
# string resource. Set it to STATIC_IP for anything that ships (make-site-env.sh does).
# Binding a specific address needs that address to exist when the container starts, which is
# why setup.sh also sets net.ipv4.ip_nonlocal_bind — otherwise a reboot with the cable out
# leaves the stack down.
LAN_BIND=                         # ship as: LAN_BIND=192.168.8.10 (= STATIC_IP)

# OUR router's Wi-Fi + the facility name. Used to print the in-zone tablet install card
# (pkgserver/make-install-card.sh), and by the wifis: netplan fallback if the server has no wired
# port. Nothing configures the router from here. Fill in at staging once the router is set up. Quote values with spaces or metacharacters (see above).
SITE_WIFI_SSID=
SITE_WIFI_PASSWORD=               # SECRET
SITE_FACILITY_NAME='Buendia'      # printed on the card; match the root location name (A1)

# --- Head router (deploy/network/configure-router.sh) ---------------------
# The pilot ships its OWN network (FIELD-PILOT-NETWORK-SPEC.md, item D2): router at
# ROUTER_IP, server cabled at STATIC_IP, one SSID on every access point. configure-router.sh
# reads these; an exported variable overrides the file, as with the APK build.
ROUTER_IP=192.168.8.1
# Regulatory domain for the radios. It changes legal channels and TRANSMIT POWER, so a
# coverage walk is only valid for the code it was measured on. The channels below are
# non-DFS and permitted in every domain we care about, which makes CD<->DE low-risk.
ROUTER_COUNTRY=CD                 # DRC. Bench testing in the EU may want DE/PL.
ROUTER_CHANNEL_24=6               # 1/6/11 only
ROUTER_CHANNEL_5=36               # UNII-1: non-DFS. 'auto' can select DFS, which re-runs the
                                  #   availability check at every cold boot and can vacate on
                                  #   radar — "the Wi-Fi vanished", unattended, at 3am.
ROUTER_HTMODE_24=HE20             # 20 MHz on 2.4: range beats throughput (we move kilobytes)
ROUTER_HTMODE_5=HE80
ROUTER_TIMEZONE=UTC               # the router has no RTC; it is an NTP client of STATIC_IP
ROUTER_ENCRYPTION=psk2            # WPA2-PSK. NOT psk2+ccmp: the GL.iNet UI displays it but
                                  #   refuses to save it, which makes their Wireless page
                                  #   unusable for rotating the passphrase. Not sae-mixed:
                                  #   WPA3 mixed mode breaks association on older Android.

# --- Container images (PIN BY DIGEST, not floating tags) ------------------
# INTERNET AT SETUP, NONE AT RUNTIME: setup.sh --online pulls these three from the registry and
# the site never needs connectivity again. The heavy, awkward parts of the deployment (the 83 MB
# baseline seed; the tablet APK) live INSIDE these images, so nothing has to be copied onto the
# server by hand. Publish them with tools/publish-images.sh.
#
# DB: mysql:5.6 (the last version that works with OpenMRS 1.10's hardcoded storage_engine)
# with the baseline seed baked in — built by seed/build-db-image.sh.
DB_IMAGE=soldevelo/buendia-db:5.6@sha256:REPLACE_WITH_DIGEST
# The plain upstream MySQL, used ONLY as the base when building DB_IMAGE. Not used at runtime.
MYSQL_IMAGE=mysql:5.6
# Built by the reproducible build (WS-3): OpenMRS 1.10.6 + buendia.omod + xforms + webservices.rest + python2.
# Production: pin by digest. Local build/test: a plain tag is fine (e.g. buendia-openmrs:latest).
OPENMRS_IMAGE=soldevelo/buendia-openmrs:1.10.6@sha256:REPLACE_WITH_DIGEST
# Static file server on :9001 — hosts the APK for tablet install (QR code) and the two paths the
# Android client probes. Empty = compose default (nginx:alpine-slim) serving the bind-mounted
# pkgserver/www, which is the local-development path.
# For what SHIPS, prefer an image with the APK baked in (pkgserver/build-pkgserver-image.sh) so
# the APK travels by `docker pull` too. That image is SITE-SPECIFIC — the APK inside bakes in the
# server address and password — so tag it per site and rebuild it whenever the APK changes.
PKGSERVER_IMAGE=
PKGSERVER_PORT=9001               # host port; the client hardcodes :9001, so don't change it

# --- Registry (tools/publish-images.sh) -----------------------------------
REGISTRY_NAMESPACE=soldevelo       # Docker Hub namespace to publish to
# Only needed for a PRIVATE registry — the db/openmrs images are public and pull anonymously, so
# normally leave these empty. If set, setup.sh does a `docker login` before pulling.
REGISTRY_USER=
REGISTRY_TOKEN=                    # SECRET (personal access token, read scope)

# --- Tablet APK payload: PRIVATE release ----------------------------------
# The APK is a CREDENTIAL: it carries the server password as a plain Android string resource
# (`openmrs_password_default`), readable with one `aapt dump --values resources`. So it never goes
# to a public namespace — unlike the db/openmrs images, which hold no secrets.
#
# Produce the asset with pkgserver/publish.sh && pkgserver/pack-www.sh, upload it to a PRIVATE
# GitHub release, and setup.sh downloads + unpacks it into pkgserver/www.
APK_SOURCE=auto                    # auto = use www/ if populated, else download when configured
                                   # github = always download · local = use www/ as-is · none = skip
APK_RELEASE_REPO=                  # owner/private-repo holding the release
APK_RELEASE_TAG=                   # release tag, e.g. pilot-1.0.0
APK_RELEASE_ASSET=                 # empty = pkgserver-www.tar.gz (pack-www.sh prints the real name)
# ⚠️ The TOKEN IS DELIBERATELY NOT IN THIS FILE. .env travels to the site server; a token must not.
#    Pass it in the environment, only when setting up:
#        GITHUB_TOKEN=<fine-grained, read-only, that repo only> sudo -E ./setup.sh
#    Prefer a fine-grained GitHub PAT scoped to the single repo — a Docker Hub read token, by
#    contrast, can pull every private repo in the account.

# --- Database credentials (SECRET — do not commit real values) -----------
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=openmrs
MYSQL_USER=openmrs
MYSQL_PASSWORD=CHANGE_ME

# --- Android APK build (deploy/apk/build-apk.sh) --------------------------
# Every value has a working default, so a bare ./build-apk.sh still produces an APK.
# APK_SERVER defaults to STATIC_IP above, so the tablet and the server can't drift apart.
APK_SERVER=                       # empty = use STATIC_IP
APK_VERSION=1.0.0                 # MUST be 1-3 dot-separated integers (the updater parses it)
APK_OPENMRS_USER=buendia
APK_OPENMRS_PASSWORD=buendia      # SECRET once rotated; baked in as the tablet's default
# INERT on the v1.0 client — leave empty. The build property exists, but nothing reads
# BuildConfig.ENCRYPTION_PASSWORD and sync/Database.java uses plain SQLite (SQLCipher was
# removed), so setting this does NOT encrypt anything. Tablet data-at-rest is covered by
# DEVICE-level Android encryption + a mandatory screen-lock PIN (deployment plan decision).
APK_ENCRYPTION_PASSWORD=
APK_NON_WIFI_ALLOWED=false        # true = allow sync over mobile data as well as wifi
APK_CHECK_INTERVAL=3600           # update-check poll, seconds (upstream default is 10)
APK_IDLE_LOGOUT_SECONDS=600       # auto-logout after idle on battery
APK_DOCKED_IDLE_LOGOUT_SECONDS=300  # ...and while AC-charging (upstream hardcoded 30 s)
APK_STARTING_PATIENT_ID=          # empty = no constraint (see MSF config request A8)
# Signing key. ONE-TIME: ./build-apk.sh --make-keystore. Android only accepts an update
# signed with the same key, so BACK THIS UP out-of-band — losing it means re-installing
# every tablet from scratch.
APK_KEYSTORE=                     # empty = deploy/apk/keystore/buendia-pilot.jks
APK_KEYSTORE_PASSWORD=            # SECRET — required to build or create the key

# --- Toolchain pins -------------------------------------------------------
DOCKER_VERSION=                   # e.g. 5:26.1.4-1~ubuntu.22.04~jammy (empty = latest at staging)

# --- Remote support -------------------------------------------------------
# THE PILOT'S CHANNEL IS TEAMVIEWER, and nothing in this file configures it. MSF installed it on
# the server laptop themselves, on their own account, and proved it: the laptop joined their
# corporate Wi-Fi while staying cabled to the Buendia router, the tablets kept working, and the
# remote session worked. Someone on site can reboot the machine and make sure it is running.
# That settles the question for the pilot — it is MSF's tool, on MSF's account, already approved
# by their IT, and it costs us no infrastructure. Whether it continues past the pilot is a
# decision to take on experience.
#
# TWO THINGS THAT FOLLOW, because TeamViewer is a DESKTOP rather than a terminal:
#   - the web UI is reached at http://<STATIC_IP>:9000/openmrs, NOT http://localhost:9000 —
#     see the LAN_BIND note in compose/docker-compose.yml for why localhost hangs;
#   - the laptop must be left logged in and awake. This deployment already disables suspend and
#     lid-sleep, so in practice that means: do not log out, and leave the lid open.
#
# THE TAILSCALE PATH BELOW IS PARKED, NOT DELETED. It stays installed and switched off, as the
# documented fallback for when support needs something TeamViewer cannot give — scripted access,
# an unattended file pull, a diagnostic run with nobody at the keyboard. Everything recorded
# here is correct and was verified; it is kept so that picking it up later is a switch, not a
# rebuild. Installing it needs the internet, so it happens in step 1 (setup.sh --prepare)
# whatever this switch says; ENABLING it is what the switch does.
ENABLE_REMOTE_SUPPORT=false
# SECRET — only set when enabling. The key must be TAGGED and NOT ephemeral, and key expiry must
# be turned OFF for this machine in the Tailscale admin console: an ephemeral node disappears
# when it goes offline, and an expired key cannot be renewed from a site with no internet — on
# the one box you most need to reach. setup.sh brings it up with --ssh (no keys to distribute,
# access governed by the tailnet ACL), --accept-dns=false (MagicDNS must not rewrite the
# resolver of a machine that is offline most of its life) and --advertise-routes for the LAN, so
# a supporter also reaches the router's admin page and the tablets.
TAILSCALE_AUTHKEY=
