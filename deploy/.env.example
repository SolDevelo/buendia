# Buendia field-pilot server — configuration.
# Copy to .env and fill in. .env is git-ignored (may contain secrets). PIN every version.

# --- Site / network -------------------------------------------------------
SITE_ID=pilot
STATIC_IP=192.168.8.10            # server's fixed LAN address (also baked into the APK)
TZ=UTC                            # server + MySQL share UTC (fixes bug 1)

# --- Container images (PIN BY DIGEST, not floating tags) ------------------
# mysql:5.6 is the last version that works with OpenMRS 1.10's hardcoded storage_engine.
MYSQL_IMAGE=mysql:5.6@sha256:REPLACE_WITH_DIGEST
# Built by the reproducible build (WS-3): OpenMRS 1.10.6 + buendia.omod + xforms + webservices.rest + python2.
# Production: pin by digest. Local build/test: a plain tag is fine (e.g. buendia-openmrs:latest).
OPENMRS_IMAGE=ghcr.io/YOUR_ORG/buendia-openmrs:1.10.6@sha256:REPLACE_WITH_DIGEST
# Optional in-network APK update server (port 9001).
PKGSERVER_IMAGE=

# --- Database credentials (SECRET — do not commit real values) -----------
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=openmrs
MYSQL_USER=openmrs
MYSQL_PASSWORD=CHANGE_ME

# --- Android APK build (deploy/apk/build-apk.sh) --------------------------
# Every value has a working default, so a bare ./build-apk.sh still produces an APK.
# APK_SERVER defaults to STATIC_IP above, so the tablet and the server can't drift apart.
APK_SERVER=                       # empty = use STATIC_IP
APK_VERSION=1.0.0                 # MUST be 1-3 dot-separated integers (the updater parses it)
APK_OPENMRS_USER=buendia
APK_OPENMRS_PASSWORD=buendia      # SECRET once rotated; baked in as the tablet's default
# Encrypts the tablet's SQLite database of patient data. Empty = UNENCRYPTED (lab only).
# Changing it later makes existing tablets unable to open their local DB — set it once, before
# tablets are provisioned, and record it with the signing-key backup.
APK_ENCRYPTION_PASSWORD=          # SECRET
APK_NON_WIFI_ALLOWED=false        # true = allow sync over mobile data as well as wifi
APK_CHECK_INTERVAL=3600           # update-check poll, seconds (upstream default is 10)
APK_IDLE_LOGOUT_SECONDS=600       # auto-logout after idle on battery
APK_DOCKED_IDLE_LOGOUT_SECONDS=300  # ...and while AC-charging (upstream hardcoded 30 s)
APK_STARTING_PATIENT_ID=          # empty = no constraint (see MSF config request A8)
# Signing key. ONE-TIME: ./build-apk.sh --make-keystore. Android only accepts an update
# signed with the same key, so BACK THIS UP out-of-band — losing it means re-installing
# every tablet from scratch.
APK_KEYSTORE=                     # empty = deploy/apk/keystore/buendia-pilot.jks
APK_KEYSTORE_PASSWORD=            # SECRET — required to build or create the key

# --- Toolchain pins -------------------------------------------------------
DOCKER_VERSION=                   # e.g. 5:26.1.4-1~ubuntu.22.04~jammy (empty = latest at staging)

# --- Remote support (Tailscale + SSH) — OFF until data-protection sign-off (§3.5/§8)
ENABLE_REMOTE_SUPPORT=false
TAILSCALE_AUTHKEY=                # SECRET — only set when enabling; prefer an ephemeral, tagged key
