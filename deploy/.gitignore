# Secrets — never commit real values
.env

# Heavy binaries — ship via GitHub Releases / Git LFS / USB, not in git
images/*.tar
images/*.tar.gz
debs/*.deb
apk/*.apk
apk/*.sha256
apk/*.buildinfo.txt
# The APK signing key IS the app's identity — never commit it. Back it up out-of-band.
apk/keystore/

# Package-server document root: entirely generated by pkgserver/publish.sh from a built APK.
pkgserver/www/*
!pkgserver/www/.gitkeep
# Printable install cards: generated, and they carry the site Wi-Fi passphrase.
pkgserver/cards/
# Release payload built by pkgserver/pack-www.sh. It contains the APK, and the APK carries the
# server password as a plain Android string resource — so it is a CREDENTIAL. It belongs in a
# PRIVATE GitHub release, never in git.
pkgserver/pkgserver-www-*.tar.gz
pkgserver/pkgserver-www-*.tar.gz.sha256
# NB: the default profile (profile/bunia.csv) IS committed — it's a package artifact, baked
# into the seed by seed/build-seed.sh. Ignore only site-tailored variants if they hold PII.
profile/site-*.csv

# Seed SQL — regenerable (base) or site-specific/patient data — keep out of git
seed/*.sql
seed/initdb/*.sql
seed/*site*
# ...EXCEPT the site seed (locations + default account). It's a small, hand-edited package
# artifact with no PII, and the package is not zero-config without it. Must come after the
# broader rules above to win.
!seed/initdb/20-buendia-site.sql

# Local artefacts
*.log
buendia-diag-*.tar.gz*
buendia-db-*.sql.gz
buendia-export-*.csv

# Keep the empty dirs tracked
!**/.gitkeep
!seed/README.md

# WS-3 image build: vendored heavy artefacts + optional maven mirror
image/artifacts/*
!image/artifacts/.gitkeep
image/settings.xml

# Deployment bundle built by tools/make-bundle.sh — a build artifact, regenerable. Holds no
# secrets (.env is supplied separately), so it is safe to publish as a release asset.
buendia-deploy-*.tar.gz
buendia-deploy-*.tar.gz.sha256
