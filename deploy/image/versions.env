# Pinned versions for the buendia-openmrs image. Single source of truth.
# Duplicated (by necessity) from openmrs/pom.xml + tools/openmrs_build — keep in sync.

OPENMRS_PLATFORM_VERSION=1.10.6
XFORMS_VERSION=4.3.5
WEBSERVICES_REST_VERSION=2.6

# Base image + build tooling (Java 7 — openjdk:7 is gone from Docker Hub; Azul Zulu 7 works)
BASE_IMAGE=azul/zulu-openjdk-debian:7   # JDK 1.7.0_352 on Debian 11 (bullseye). Pin by digest for prod.
MAVEN_VERSION=3.5.4                      # last Maven that runs on Java 7

# Servlet container (EOL — pinned deliberately, see plan §3.1)
TOMCAT_VERSION=7.0.109                   # last Tomcat 7.0.x (archive.apache.org)

# Image naming (override with --tag)
IMAGE_NAME=buendia-openmrs

# --- Artifact URLs for `build-image.sh --fetch` (verified against the repo) -----
# NB: OpenMRS omods are published with a .jar extension in the Maven repo; an .omod
# IS a jar, so we download the .jar and drop it in as <name>.omod.
OPENMRS_MAVEN_REPO=https://mavenrepo.openmrs.org/public
WAR_URL=${OPENMRS_MAVEN_REPO}/org/openmrs/web/openmrs-webapp/${OPENMRS_PLATFORM_VERSION}/openmrs-webapp-${OPENMRS_PLATFORM_VERSION}.war
XFORMS_URL=${OPENMRS_MAVEN_REPO}/org/openmrs/module/xforms-omod/${XFORMS_VERSION}/xforms-omod-${XFORMS_VERSION}.jar
WSREST_URL=${OPENMRS_MAVEN_REPO}/org/openmrs/module/webservices.rest-omod/${WEBSERVICES_REST_VERSION}/webservices.rest-omod-${WEBSERVICES_REST_VERSION}.jar
